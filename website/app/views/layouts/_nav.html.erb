<header class="site-header">
  <nav class="site-nav" aria-label="<%= t "nav.label" %>">
    <%= link_to_page "index", label: render("layouts/wordmark", css: "wordmark-nav"), class: "site-nav-brand" %>
    <ul class="site-nav-links">
      <% %w[features buy guides about].each do |slug| %>
        <li><%= link_to_page slug, label_type: :nav, "aria-current": ("page" if on_page?(slug)) %></li>
      <% end %>
    </ul>
    <div class="site-nav-actions">
      <%= render "layouts/locale_switcher" %>
      <%= link_to_page "manage", label: t("nav.manage"), class: "site-nav-manage", "aria-current": ("page" if on_page?("manage")) %>
      <%= link_to_page "skyblip-go", label: t("nav.try"), class: "button button--primary button--small" %>
    </div>
  </nav>
</header>
