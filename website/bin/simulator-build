#!/usr/bin/env sh

# What the pages take from simulator/, dropped into public/ under the commit it
# was built from: the Bluetooth update client the manage page loads, then the
# WASM build of the firmware and the case the skyBlip Go page embeds. public/ is
# copied into the Parklife build verbatim, so nothing here goes through the asset
# pipeline, and the client's modules can import each other by relative path.
#
# Without Emscripten only the update client is copied and the simulator renders
# its fallback. CI sets SIMULATOR_REQUIRED=1, so a missing toolchain fails the
# build that is meant to publish one.

set -eu

firmware="$(CDPATH='' cd -- "$(dirname -- "$0")/../../firmware" && pwd)"
harness="$(CDPATH='' cd -- "$(dirname -- "$0")/../../simulator" && pwd)"
public="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)/public/simulator"
build="$(git -C "$firmware" rev-parse --short HEAD)"

rm -rf "$public"

mkdir -p "$public/$build"
cp "$harness/ble.js" "$harness/cbor.js" "$harness/smp.js" "$harness/image.js" "$harness/update.js" \
   "$public/$build/"
echo "update client: public/simulator/$build"

if ! command -v emcc >/dev/null 2>&1; then
  if [ "${SIMULATOR_REQUIRED:-0}" = "1" ]; then
    echo "FAIL: emcc not found and SIMULATOR_REQUIRED=1" >&2
    exit 1
  fi
  echo "simulator: emcc not found, the page will show its fallback"
  exit 0
fi

make -C "$firmware" browser

cp "$firmware/build/browser/skyblip_simulator.js" \
   "$firmware/build/browser/skyblip_simulator.wasm" \
   "$firmware/build/browser/embed.js" \
   "$harness/device.css" \
   "$public/$build/"
echo "simulator: public/simulator/$build"
