  // The stack: the cell takes the banner and the state word it displaced reads under it.
  {
    name: "low-battery-taxi",
    page: PAGE.Radar,
    shot(device) {
      device.fly({ kt: 6, ft: 340, track: 90, fpm: 0, dps: 0 }).run(30_000);
      device.sim.setBatteryMv(3400);
      device.run(20_000);
    }
  },
  // The update page's last resort: off on this page, and the next press starts the bootloader.
  {
    name: "recovery",
    powered: false,
    shot: device => asksFor(device, `{"cmd":"recovery"}`).allow().run(6000)
  },
  {
    name: "off",
    powered: false,
    shot: device => device.fly(CRUISE).run(20_000).holdButton(HOLD_OFF_MS).run(6000)
  },
  // Nobody asked for this power-off, so the cutoff writes its own reason on the way down.
  {
    name: "off-flat-battery",
    powered: false,
    shot(device) {
      device.fly(CRUISE).run(20_000);
      device.sim.setBatteryMv(3100);
      device.run(20_000);
      const frame = png(panel(device.run(SETTLE_MS)));
      if (!frame.equals(REFUSED_ON_A_SHELF))
        throw new Error("the cutoff and the refused boot do not write the same glass");
      return frame;
    }
  }
];

// The other road: a cell emptied on a shelf ran no shutdown, so the refused press names it.
async function refusedOnAShelf() {
  const device = await Device.boot({ batteryMv: 3300 });
  return png(panel(device.sleepAgain()));
}

const REFUSED_ON_A_SHELF = await refusedOnAShelf();

// Sixteen rows hold about two seconds of a busy sky, and a name goes out once in
// ten, so the tape is caught on the pass one lands rather than wherever it was.
function tapeWithANameOnIt(device) {
  const before = device.sim.txNamed();
  for (let second = 0; second < 12; second++) {
    device.run(1000);
    if (device.sim.txNamed() > before) return png(panel(device.run(150)));
  }
  throw new Error("twelve seconds of tape and own-ship never named itself");
}

// The wedge flashes at a flip a second, and the inverted phase is the most ink it puts up.
function brightestFlip(device) {
  let best = null;
  for (let flip = 0; flip < 6; flip++) {
    device.run(1000);
    const ink = device.ink();
    if (!best || ink > best.ink) best = { ink, frame: png(panel(device)) };
  }
  return best.frame;
}

function verify(scene, device) {
  const { sim } = device;
  const got = {
    page: sim.page(),
    menu: sim.menuOpen() === 1,
    alarm: sim.alarm(),
    powered: sim.powered() === 1,
    prompt: sim.prompt() === 1
  };
  const want = { menu: false, alarm: 0, powered: true, prompt: false, ...scene };
  if (want.powered && want.page === undefined)
    throw new Error(`${scene.name}: the scene names no page, so nothing here reads the glass`);
  for (const key of Object.keys(got))
    if (want[key] !== undefined && want[key] !== got[key])
      throw new Error(`${scene.name}: ${key} is ${got[key]}, the page wants ${want[key]}`);
}

// The blips of the legend, drawn by the firmware's own widget rather than redrawn here.
function* drawnBlips() {
  const exe = join(tmpdir(), "skyblip-blips");
  execFileSync(
    "c++",
    [
      "-std=c++17", "-O1", `-I${firmware}`, "-fno-exceptions", "-fno-rtti",
      join(website, "bin", "blips.cpp"),
      join(firmware, "ui", "canvas.cpp"),
      join(firmware, "ui", "widgets", "blip.cpp"),
      "-o", exe
    ],
    { stdio: "inherit" }
  );

  const lines = execFileSync(exe, { encoding: "utf8" }).split("\n");
  for (let at = 0; at < lines.length && lines[at]; ) {
    const [name, w, h] = lines[at++].split(" ");
    const stride = (Number(w) + 7) >> 3;
    const bits = new Uint8Array(stride * Number(h));
    for (let y = 0; y < Number(h); y++, at++)
      for (let x = 0; x < Number(w); x++)
        if (lines[at][x] === "1") bits[y * stride + (x >> 3)] |= 0x80 >> (x & 7);
    yield [name, { w: Number(w), h: Number(h), stride, bits }];
  }
}

mkdirSync(shots, { recursive: true });
for (const scene of scenes) {
  const device = await Device.boot();
  device.run(STEP_MS);
  const captured = scene.shot(device);
  const shot = captured instanceof Buffer ? captured : png(panel(device.run(SETTLE_MS)));
  verify(scene, device);
  writeFileSync(join(shots, `${scene.name}.png`), shot);
  console.log(`${scene.name}.png  ${shot.length} bytes`);
}

mkdirSync(blips, { recursive: true });
for (const [name, canvas] of drawnBlips()) {
  const shot = png(canvas);
  writeFileSync(join(blips, `${name}.png`), shot);
  console.log(`blips/${name}.png  ${shot.length} bytes`);
}
