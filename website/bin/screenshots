  {
    name: "gmeter",
    page: PAGE.GMeter,
    shot(device) {
      device.fly(CRUISE).run(20_000).walkTo(PAGE.GMeter);
      for (const slip of [400, -300, 0]) device.fly({ slip }).run(4000);
    }
  },
  {
    name: "menu-radar",
    page: PAGE.Radar,
    menu: true,
    shot: device =>
      setCallsign(device, OWN_CALLSIGN).fly(CRUISE).run(20_000).openMenu(PAGE.Radar)
  },
  {
    name: "menu-callsign",
    page: PAGE.Radar,
    menu: true,
    shot(device) {
      setCallsign(device, OWN_CALLSIGN);
      device.openMenu(PAGE.Radar, RADAR_MENU.Callsign).press();
      // Two characters in, so the bar is under a character and not at either end.
      return device.press().press();
    }
  },
  {
    name: "menu-callsign-blank",
    page: PAGE.Radar,
    menu: true,
    shot(device) {
      setCallsign(device, OWN_CALLSIGN);
      device.openMenu(PAGE.Radar, RADAR_MENU.Callsign).press();
      // S through the letters and the digits, round to the blank the clear is armed on.
      for (let roll = 0; roll < 18; roll++) device.tap();
      return device;
