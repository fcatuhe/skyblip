    name: "radar-to-scale",
    page: PAGE.Radar,
    shot: device => flying(device.plotToScale())
  },
  {
    name: "far-all",
    page: PAGE.Radar,
    shot: device => farSky(device)
  },
  {
    name: "far-to-scale",
    page: PAGE.Radar,
    shot: device => farSky(device.plotToScale())
  },
  {
    name: "astern-all",
    page: PAGE.Radar,
    shot: device => astern(device)
  },
  {
    name: "astern-to-scale",
    page: PAGE.Radar,
    shot: device => astern(device.plotToScale())
  },
  {
    name: "alarm",
    page: PAGE.Radar,
    alarm: ADVISORY,
    shot(device) {
      flying(device).traffic({
        bearing: 38,
        range: 2500,
        ft: 100,
