#!/usr/bin/env node

// The device screens on the skyBlip Go page, off the firmware's WASM (../README.md).

import { execFileSync } from "node:child_process";
import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { deflateSync } from "node:zlib";

const website = dirname(dirname(fileURLToPath(import.meta.url)));
const firmware = join(website, "..", "firmware");
const dist = join(firmware, "build", "browser");
const shots = join(website, "content_images", "pages", "skyblip-go");
const blips = join(shots, "blips");

const INK = [0x14, 0x14, 0x14];
const PAPER = [0xc9, 0xc9, 0xc4];
const STEP_MS = 5;
const CONTACT_MS = 120;
// Two presses inside the gesture's 600 ms window are one double press, not two steps.
const PRESS_GAP_MS = 800;
const TAP_GAP_MS = 500;
const ALLOW_GAP_MS = 200;
const PROMPT_MS = 2500;
const GROUND_MS = 20_000;
const SETTLE_MS = 2500;
const HOLD_OFF_MS = 2200;
const KT_TO_MM_S = 514;
const FPM_TO_MM_S = 5080;
const FEET_PER_METRE = 3.28084;

execFileSync("make", ["-C", firmware, "browser"], { stdio: "inherit" });
const { load } = await import(join(dist, "embed.js"));
const wasm = readFileSync(join(dist, "skyblip_simulator.wasm"));

class Device {
  static async boot(boot = undefined) {
    let memory = null;
    const sim = await load({
      boot,
      instantiateWasm(imports, done) {
        const instance = new WebAssembly.Instance(new WebAssembly.Module(wasm), imports);
        memory = instance.exports.memory;
        done(instance);
        return instance.exports;
      }
    });
    return new Device(sim, memory);
  }

  constructor(sim, memory) {
    this.sim = sim;
    this.memory = memory;
    this.now = 0;
  }

  run(ms) {
    this.now = this.sim.advance(this.now + ms);
    return this;
  }

  sleepAgain() {
    this.now = this.sim.sleepAgain();
    return this;
  }

  press() {
    this.sim.button();
    return this.run(PRESS_GAP_MS);
  }

  tap() {
    this.sim.holdPad(1);
    this.run(CONTACT_MS);
    this.sim.holdPad(0);
    return this.run(TAP_GAP_MS);
  }

  // Two presses inside ConfirmGesture::kDoublePressMs, which is what authorises.
  allow() {
    this.sim.button();
    this.run(ALLOW_GAP_MS);
    this.sim.button();
    return this.run(PRESS_GAP_MS);
  }

  holdButton(ms) {
    this.sim.holdButton(1);
    this.run(ms);
    this.sim.holdButton(0);
    return this.run(PRESS_GAP_MS);
  }

  fly({ kt, ft, track, fpm, dps, slip }) {
    const { sim } = this;
    if (kt !== undefined) sim.setSpeed(kt);
    if (ft !== undefined) sim.setAlt(Math.round(ft / FEET_PER_METRE));
    if (track !== undefined) sim.setTrack(track);
    if (fpm !== undefined) sim.setClimb(Math.round((fpm * FPM_TO_MM_S) / 1000));
    if (dps !== undefined) sim.setTurn(Math.round(dps * 10));
    if (slip !== undefined) sim.setSlip(slip);
    return this;
  }

  // Bearing in degrees true, range in metres, height above own ship in feet.
  // `callsign` is what that aircraft puts on air itself, once every ten seconds.
  traffic({ bearing, range, ft = 0, kt = 110, track = 0, fpm = 0, addr, alptas = 0, callsign }) {
    const radians = (bearing * Math.PI) / 180;
    this.sim.addAircraft(
      Math.round(Math.cos(radians) * range),
      Math.round(Math.sin(radians) * range),
      Math.round(ft / FEET_PER_METRE),
      Math.round((kt * KT_TO_MM_S) / 1000),
      track,
      0,
      Math.round((fpm * FPM_TO_MM_S) / 1000),
      alptas,
      addr
    );
    if (callsign) this.sim.nameAircraft(this.sim.aircraftCount() - 1, callsign);
    return this;
  }

  walkTo(page) {
    for (let step = 0; step < WALKED_PAGES && this.sim.page() !== page; step++) this.tap();
    if (this.sim.page() !== page) throw new Error(`the walk never reached page ${page}`);
    return this;
  }

  openMenu(page, row = 0) {
    this.walkTo(page).press();
    for (let step = 0; step < row; step++) this.tap();
    return this;
  }

  // The pad walks off the last row back to the page the menu belongs to.
  closeMenu() {
    for (let step = 0; step < MENU_ROWS_CEILING && this.sim.menuOpen(); step++) this.tap();
    if (this.sim.menuOpen()) throw new Error("the pad never walked off the menu");
    return this;
  }

  plotToScale() {
    return this.openMenu(PAGE.Radar, RADAR_MENU.Plot).press().closeMenu();
  }

  frame() {
    const base = this.sim.fb();
    return new Uint8Array(this.memory.buffer, base, this.sim.H * this.sim.STRIDE).slice();
  }

  ink() {
    let count = 0;
    for (const byte of this.frame()) for (let bit = byte; bit; bit >>= 1) count += bit & 1;
    return count;
  }
}

const crcTable = Array.from({ length: 256 }, (_, index) => {
  let c = index;
  for (let bit = 0; bit < 8; bit++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
  return c >>> 0;
});

function crc32(bytes) {
  let c = 0xffffffff;
  for (const byte of bytes) c = crcTable[(c ^ byte) & 0xff] ^ (c >>> 8);
  return (c ^ 0xffffffff) >>> 0;
}

function chunk(type, body) {
  const head = Buffer.alloc(4);
  head.writeUInt32BE(body.length);
  const tagged = Buffer.concat([Buffer.from(type, "ascii"), body]);
  const crc = Buffer.alloc(4);
  crc.writeUInt32BE(crc32(tagged));
  return Buffer.concat([head, tagged, crc]);
}

// One bit per pixel, ink set, so a canvas is a 1-bit colormapped PNG row for row.
function png({ w, h, stride, bits }) {
  const raw = Buffer.alloc(h * (stride + 1));
  for (let y = 0; y < h; y++) {
    raw[y * (stride + 1)] = 0;
    Buffer.from(bits.subarray(y * stride, (y + 1) * stride)).copy(raw, y * (stride + 1) + 1);
  }
  const header = Buffer.alloc(13);
  header.writeUInt32BE(w, 0);
  header.writeUInt32BE(h, 4);
  header[8] = 1;
  header[9] = 3;
  return Buffer.concat([
    Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]),
    chunk("IHDR", header),
    chunk("PLTE", Buffer.from([...PAPER, ...INK])),
    chunk("IDAT", deflateSync(raw, { level: 9 })),
    chunk("IEND", Buffer.alloc(0))
  ]);
}

function panel(device) {
  const { W, H, STRIDE } = device.sim;
  return { w: W, h: H, stride: STRIDE, bits: device.frame() };
}

const OWN_CALLSIGN = "S-BLIP";

// The only way a callsign reaches the device: an app writes it on the config
// endpoint, the glass asks, and two presses allow it. A write is refused unless
// the device knows it is on the ground, so the aircraft is parked first.
function asks(device, callsign) {
  return asksFor(device, `{"cmd":"set","callsign":"${callsign}"}`);
}

function asksFor(device, command) {
  device.fly({ ...CRUISE, kt: 0 }).run(GROUND_MS);
  device.sim.sendConfig(command);
  device.run(PROMPT_MS);
  if (!device.sim.prompt()) throw new Error(`${command} never reached the glass`);
  return device;
}

function setCallsign(device, callsign) {
  asks(device, callsign).allow();
  if (device.sim.prompt()) throw new Error("two presses did not answer the prompt");
  return device;
}

// The device as a pilot has it after setup: named on the ground, then flown.
function namedAndFlying(device) {
  return flying(setCallsign(device, OWN_CALLSIGN));
}
const CRUISE = { kt: 95, ft: 3911, track: 0, fpm: 0, dps: 0 };
const LEG_MS = 47 * 60_000;
const HEARD_MS = 20_000;

// One above, one below, one level and climbing, all outside the 3 km an advisory starts at.
function neighbours(device) {
  return device
    .traffic({ bearing: 320, range: 2600, ft: 1200, kt: 120, track: 290, addr: 0x3fa21c })
    .traffic({ bearing: 95, range: 3600, ft: -800, kt: 140, track: 120, addr: 0x4c11a0 })
    .traffic({
      bearing: 215, range: 3300, ft: -150, kt: 70, track: 200, fpm: 600,
      addr: 0x300003, callsign: "D-KXYZ"
    });
}

// A leg long enough for the clock to read like a logbook entry, then the sky.
function flying(device) {
  return neighbours(device.fly(CRUISE).run(LEG_MS)).run(HEARD_MS);
}

function firmwareSource(...parts) {
  return readFileSync(join(firmware, ...parts), "utf8");
}

function inside(source, pattern, what) {
  const found = source.match(pattern);
  if (!found) throw new Error(`${what} is not where this tool reads it in the firmware`);
  return found[1];
}

function pagesOf(source) {
  const body = inside(source, /enum class Page : uint8_t \{([^}]*)\}/, "the Page enum");
  const pages = {};
  let id = 0;
  for (const entry of body.split(",")) {
    const named = entry.match(/(\w+)\s*(?:=\s*(\d+))?\s*$/);
    if (!named) continue;
    if (named[2] !== undefined) id = Number(named[2]);
    pages[named[1]] = id++;
  }
  delete pages.kCount;
  return pages;
}

function menuRowsOf(source, array) {
  const body = inside(source, new RegExp(`${array}\\[\\] = \\{([^}]*)\\}`), array);
  const rows = {};
  for (const [, row] of body.matchAll(/MenuRow::(\w+)/g)) rows[row] = Object.keys(rows).length;
  return rows;
}

const pageHeader = firmwareSource("products", "skyblip_go", "pages", "page.h");
const menuSource = firmwareSource("products", "skyblip_go", "pages", "menu.cpp");
const PAGE = pagesOf(pageHeader);
const RADAR_MENU = menuRowsOf(menuSource, "kRadarMenuRows");
const NEARBY_MENU = menuRowsOf(menuSource, "kNearbyMenuRows");
const WALKED_PAGES = Number(
  inside(pageHeader, /constexpr int kWalkedPages = (\d+);/, "kWalkedPages")
);
const ADVISORY = 1;
const MENU_ROWS_CEILING = 12;

// The same sky both ways: what the ring holds, and what lies past it and past the glass.
function farSky(device) {
  return flying(device)
    .traffic({ bearing: 8, range: 9800, ft: 400, kt: 150, track: 190, addr: 0x3d0a41 })
    .traffic({ bearing: 48, range: 15000, ft: 900, kt: 60, track: 0, addr: 0x4a1102 })
    .traffic({ bearing: 50, range: 15600, ft: 1500, kt: 60, track: 120, addr: 0x4a1103 })
    .traffic({ bearing: 46, range: 15300, ft: 600, kt: 60, track: 240, addr: 0x4a1104 })
    .traffic({ bearing: 285, range: 21000, ft: -1200, kt: 120, track: 90, addr: 0x3e5510 })
    .run(HEARD_MS);
}

function astern(device) {
  return device
    .fly(CRUISE)
    .run(LEG_MS)
    .traffic({ bearing: 180, range: 11000, ft: -300, kt: 120, track: 0, addr: 0x3f0001 })
    .traffic({ bearing: 172, range: 13500, ft: 500, kt: 110, track: 350, addr: 0x3f0002 })
    .traffic({ bearing: 174, range: 14000, ft: 700, kt: 110, track: 350, addr: 0x3f0003 })
    .traffic({ bearing: 205, range: 6400, ft: -100, kt: 150, track: 20, addr: 0x3f0004 })
    .run(HEARD_MS);
}

