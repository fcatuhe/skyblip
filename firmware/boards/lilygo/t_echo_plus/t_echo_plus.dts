/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/regulator/nrf5x.h>


/ {
	model = "LilyGO T-Echo Plus";
	compatible = "lilygo,t-echo-plus";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
	};

	aliases {
		radio-spi = &spi3;
		epd-spi = &spi2;
		gnss-uart = &uart0;
		sensor-i2c = &i2c0;
		buzzer = &buzzer_pwm;
		haptic-enable = &haptic_enable_gpio;
		button = &button_gpio;
		pad = &pad_gpio;
		gnss-pps = &gnss_pps_gpio;
		led-green = &led_green;
		led-red = &led_red;
		led-blue = &led_blue;
		gnss-wake = &gnss_wake_gpio;
		gnss-reset = &gnss_reset_gpio;
		peripheral-rail = &peripheral_rail_gpio;
		regulator-enable = &regulator_enable_gpio;
		flash-write-protect = &flash_write_protect_gpio;
		flash-hold = &flash_hold_gpio;
		radio-reset = &radio_reset_gpio;
		watchdog0 = &wdt0;
	};

	board_gpios {
		compatible = "gpio-keys";

		/* Plus-only haptic driver enable (P0.08). */
		haptic_enable_gpio: haptic_enable {
			gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;
			label = "haptic-enable";
		};

		button_gpio: button {
			gpios = <&gpio1 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "button";
		};

		/* Capacitive touch pad, touched reads low, from SoftRF iomap/LilyGO_TEcho.h:68. */
		pad_gpio: pad {
			gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;
			label = "pad";
		};

		/* L76K 1 PPS: the slot clock's only hardware anchor. */
		gnss_pps_gpio: gnss_pps {
			gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>;
			label = "gnss-pps";
		};
	};

	/* Power and reset pins, a pin map disabled so no driver binds it: README.md */
	board_power_gpios {
		compatible = "gpio-keys";
		status = "disabled";

		/* The e-paper, flash, GNSS and sensor rail, SoftRF LilyGO_TEcho.h:80-81. */
		peripheral_rail_gpio: peripheral_rail {
			gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
			label = "peripheral-rail";
		};

		/* Enables U11, which feeds the SoC and the SX1262, so it is never lowered. */
		regulator_enable_gpio: regulator_enable {
			gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
			label = "regulator-enable";
		};

		/* Flash WP# and HOLD#, real inputs in single-line mode, held high by board.c. */
		flash_write_protect_gpio: flash_write_protect {
			gpios = <&gpio0 7 GPIO_ACTIVE_HIGH>;
			label = "flash-write-protect";
		};

		flash_hold_gpio: flash_hold {
			gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;
			label = "flash-hold";
		};

		/* L76K WAKE_UP and RESET_N, SoftRF nRF52.cpp:1589-1593. */
		gnss_wake_gpio: gnss_wake {
			gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>;
			label = "gnss-wake";
		};

		gnss_reset_gpio: gnss_reset {
			gpios = <&gpio1 5 GPIO_ACTIVE_LOW>;
			label = "gnss-reset";
		};

		/* SX1262 NRESET, which pins.h checks its flat pin number against. */
		radio_reset_gpio: radio_reset {
			gpios = <&gpio0 25 GPIO_ACTIVE_LOW>;
			label = "radio-reset";
		};
	};

	/* Pins board.c reads before any bus driver claims them, disabled like board_power_gpios. */
	board_probe_gpios {
		compatible = "gpio-keys";
		status = "disabled";

		/* MOSI and SCK are bit-banged for the panel ID, then spi2 owns them. */
		epd_dc_gpio: epd_dc {
			gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>;
			label = "epd-dc";
		};

		epd_reset_gpio: epd_reset {
			gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
			label = "epd-reset";
		};

		epd_busy_gpio: epd_busy {
			gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
			label = "epd-busy";
		};

		epd_mosi_gpio: epd_mosi {
			gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;
			label = "epd-mosi";
		};

		epd_sck_gpio: epd_sck {
			gpios = <&gpio0 31 GPIO_ACTIVE_HIGH>;
			label = "epd-sck";
		};

		/* The buzzer PWM's P0.06, read once before pwm0 binds. */
		buzzer_sense_gpio: buzzer_sense {
			gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
			label = "buzzer-sense";
		};
	};

	/* Lines the drivers drive through io::Gpio, named so pins.h can check them: README.md */
	board_part_gpios {
		compatible = "gpio-keys";
		status = "disabled";

		radio_busy_gpio: radio_busy {
			gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;
			label = "radio-busy";
		};

		/* SX1262 DIO1, read as a level, because a dwell runs on a deadline, not an edge. */
		radio_dio1_gpio: radio_dio1 {
			gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
			label = "radio-dio1";
		};

		/* The e-paper's front light, not a panel enable, SoftRF iomap/LilyGO_TEcho.h:78. */
		epd_backlight_gpio: epd_backlight {
			gpios = <&gpio1 11 GPIO_ACTIVE_HIGH>;
			label = "epd-backlight";
		};
	};

	pwmleds {
		compatible = "pwm-leds";
		buzzer_pwm: buzzer_pwm {
			pwms = <&pwm0 0 PWM_HZ(2000) PWM_POLARITY_NORMAL>;
		};
	};

	/* The REV_2 and Plus status LEDs, active-low, not the older T-Echo's map: README.md */
	leds {
		compatible = "gpio-leds";

		led_green: led_green {
			gpios = <&gpio1 1 GPIO_ACTIVE_LOW>;
			label = "status-green";
		};

		led_red: led_red {
			gpios = <&gpio1 3 GPIO_ACTIVE_LOW>;
			label = "status-red";
		};

		led_blue: led_blue {
			gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
			label = "status-blue";
		};
	};

	/* The cell behind a 100K over 100K divider: README.md */
	vbatt: vbatt {
		compatible = "voltage-divider";
		io-channels = <&adc 2>;
		output-ohms = <100000>;
		full-ohms = <200000>;
	};
};

/* A 3.6 V full scale over the divider's 2.1 V, and 40 us for a 100K source to settle. */
&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN2>;
		zephyr,resolution = <12>;
	};
};

&pinctrl {
	spi3_default: spi3_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 19)>,
				<NRF_PSEL(SPIM_MOSI, 0, 22)>,
				<NRF_PSEL(SPIM_MISO, 0, 23)>;
		};
	};
	spi3_sleep: spi3_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 19)>,
				<NRF_PSEL(SPIM_MOSI, 0, 22)>,
				<NRF_PSEL(SPIM_MISO, 0, 23)>;
			low-power-enable;
		};
	};

	/* The panel is write-only, and the placeholder MISO avoids P0.07, the flash's WP#. */
	spi2_default: spi2_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 31)>,
				<NRF_PSEL(SPIM_MOSI, 0, 29)>,
				<NRF_PSEL(SPIM_MISO, 1, 7)>;
		};
	};
	spi2_sleep: spi2_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 31)>,
				<NRF_PSEL(SPIM_MOSI, 0, 29)>,
				<NRF_PSEL(SPIM_MISO, 1, 7)>;
			low-power-enable;
		};
	};

	/* External flash on SPIM1, single-line, so board.c holds IO2 and IO3 high: README.md */
	spi1_default: spi1_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 14)>,
				<NRF_PSEL(SPIM_MOSI, 1, 12)>,
				<NRF_PSEL(SPIM_MISO, 1, 13)>;
		};
	};
	spi1_sleep: spi1_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 14)>,
				<NRF_PSEL(SPIM_MOSI, 1, 12)>,
				<NRF_PSEL(SPIM_MISO, 1, 13)>;
			low-power-enable;
		};
	};

	uart0_default: uart0_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 8)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 9)>;
			bias-pull-up;
		};
	};
	uart0_sleep: uart0_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 8)>, <NRF_PSEL(UART_RX, 1, 9)>;
			low-power-enable;
		};
	};

	/* TWIM0 is free, because nothing uses SPIM0, which shares its peripheral ID. */
	i2c0_default: i2c0_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 26)>, <NRF_PSEL(TWIM_SCL, 0, 27)>;
		};
	};
	i2c0_sleep: i2c0_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 26)>, <NRF_PSEL(TWIM_SCL, 0, 27)>;
			low-power-enable;
		};
	};

	/* Buzzer PWM, Plus only (Meshtastic t-echo-plus PIN_BUZZER). */
	pwm0_default: pwm0_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 6)>;
		};
	};
	pwm0_sleep: pwm0_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 6)>;
			low-power-enable;
		};
	};
};

&gpio0 { status = "okay"; };
&gpio1 { status = "okay"; };
&gpiote { status = "okay"; };

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

&spi3 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi3_default>;
	pinctrl-1 = <&spi3_sleep>;
	pinctrl-names = "default", "sleep";
	/* The SX1262 driver drives CS itself through io::Spi::select. */
	cs-gpios = <&gpio0 24 GPIO_ACTIVE_LOW>;
};

&spi2 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi2_default>;
	pinctrl-1 = <&spi2_sleep>;
	pinctrl-names = "default", "sleep";
	/* The SSD1681 driver drives CS itself through io::Spi::select. */
	cs-gpios = <&gpio0 30 GPIO_ACTIVE_LOW>;
};

/* Our own parts probe this bus, so nothing on it is declared: README.md */
&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";
	/* At 100 kHz one 240-byte BHI260AP chunk outlasts the service pass. */
	clock-frequency = <I2C_BITRATE_FAST>;
};

&uart0 {
	compatible = "nordic,nrf-uarte";
	status = "okay";
	current-speed = <9600>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};

/* DC-DC needs the inductor on DCC/DEC4, which meshcore shows fitted: README.md */
&reg1 {
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

/* The bootloader's GPREGRET, unprefixed, so a one-byte write is the magic. */
&gpregret1 {
	uf2_boot_retention: retention@0 {
		compatible = "zephyr,retention";
		status = "okay";
		reg = <0x0 0x1>;
	};
};

/* The application's own byte, kept through SYSTEM OFF: core/power/README.md */
&gpregret2 {
	glass_retention: retention@0 {
		compatible = "zephyr,retention";
		status = "okay";
		reg = <0x0 0x1>;
	};
};

/* A .uf2 writes 0x1000..0xEA000 only, MCUboot and slot0: README.md */
&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/* MBR and SoftDevice S140 6.1.1, declared so nothing allocates over them. */
		softdevice_partition: partition@0 {
			label = "softdevice";
			read-only;
			reg = <0x00000000 0x00026000>;
		};

		boot_partition: partition@26000 {
			label = "mcuboot";
			reg = <0x00026000 0x0000E000>;
		};

		slot0_partition: partition@34000 {
			label = "image-0";
			reg = <0x00034000 0x000B6000>;
		};

		/* Above USER_FLASH_END, below the LittleFS others keep at 0xED000. */
		identity_partition: partition@ea000 {
			label = "identity";
			reg = <0x000EA000 0x00001000>;
		};

		storage_partition: partition@ec000 {
			label = "storage";
			reg = <0x000EC000 0x00008000>;
		};

		/* Out of the application's reach, so a bad MCUboot needs no SWD. */
		uf2_boot_partition: partition@f4000 {
			label = "uf2-bootloader";
			read-only;
			reg = <0x000F4000 0x0000C000>;
		};
	};
};

/* One of two NOR parts is fitted, so the generic driver reads SFDP at runtime: README.md */
&spi1 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi1_default>;
	pinctrl-1 = <&spi1_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio1 15 GPIO_ACTIVE_LOW>;

	ext_flash: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		/* The SPIM1 ceiling, within 03h READ spec on both parts. */
		spi-max-frequency = <8000000>;
		/* Unenforced under SFDP_RUNTIME, kept because the binding wants it. */
		jedec-id = [c2 28 15];
		/* Bits, not bytes: 16 Mbit is 2 MiB. */
		size = <16777216>;
		/* A previous image may leave the chip in deep power-down. */
		has-dpd;
		t-enter-dpd = <10000>;
		t-exit-dpd = <35000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/* Exactly slot0's size: README.md */
			slot1_partition: partition@0 {
				label = "image-1";
				reg = <0x00000000 0x000B6000>;
			};

			log_partition: partition@b6000 {
				label = "logs";
				reg = <0x000B6000 0x0012A000>;
			};

			/* The BHI260AP image, last so the log keeps its offset. */
			imu_image_partition: partition@1e0000 {
				label = "imu-image";
				reg = <0x001E0000 0x00020000>;
			};
		};
	};
};
