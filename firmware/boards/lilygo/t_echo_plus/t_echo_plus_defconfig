CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y
CONFIG_GPIO=y
CONFIG_CLOCK_CONTROL=y
CONFIG_SERIAL=y
# Link into slot0, the devicetree's code partition, never at 0x0 over the factory MBR and SoftDevice.
CONFIG_USE_DT_CODE_PARTITION=y

# No CONFIG_BUILD_OUTPUT_UF2: it would wrap the unsigned image MCUboot refuses, and scripts/mkuf2.py builds the real .uf2.
