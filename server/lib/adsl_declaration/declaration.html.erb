<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>skyBlip Go ADS-L declaration of conformity</title>
    <%= stylesheet_link_tag "reset", "_global", "base", "wordmark", "declaration" %>
    <link rel="stylesheet" href="/declaration.css">
  </head>
  <body class="declaration">
    <header class="declaration-header">
      <%= render "layouts/wordmark", css: "declaration-wordmark" %>
      <p class="declaration-draft">Draft of <%= Date.current.strftime("%-d %B %Y") %>, not signed</p>
    </header>

    <h1>Declaration of Conformity</h1>
    <%= render "shared/adsl_declaration" %>
  </body>
</html>
