<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <%= stylesheet_link_tag "reset", "_global", "base", "wordmark", "features", "products" %>
    <link rel="stylesheet" href="/card.css">
  </head>
  <body class="card">
    <div class="card-words">
      <%= render "layouts/wordmark", css: "card-wordmark" %>
      <p class="card-name"><%= card[:name] %></p>
      <p class="card-protocols"><%= card[:protocols] %></p>
      <p class="card-site">skyblip.eu</p>
    </div>
    <div class="card-art">
      <% if card[:photos] %>
        <figure class="card-photos">
          <%= safe_join card[:photos].map { |photo| image_tag photo, alt: "", class: [ Content::Image.new(photo).dimensions.then { |width, height| height > width ? "card-photo--portrait" : "card-photo--landscape" }, ShareImages::PHOTO_CLASSES[photo] ] }, tag.span("+", class: "pair-plus") %>
        </figure>
      <% else %>
        <figure class="shot"><%= image_tag card[:screen], alt: "" %></figure>
      <% end %>
    </div>
  </body>
</html>
