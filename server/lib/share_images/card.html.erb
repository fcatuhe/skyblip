<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <%= stylesheet_link_tag "reset", "_global", "base", "wordmark", "features", "diagram" %>
    <link rel="stylesheet" href="/card.css">
  </head>
  <body class="card">
    <div class="card-words">
      <%= render "layouts/wordmark", css: "card-wordmark" %>
      <p class="card-name"><%= card[:name] %></p>
      <p class="card-protocols"><%= card[:protocols] %></p>
      <% if card[:in_development] %>
        <p class="card-status"><%= t "share.in_development" %></p>
      <% end %>
      <p class="card-site">skyblip.eu</p>
    </div>
    <div class="card-art">
      <% if card[:photo] %>
        <figure class="shot shot--photo"><%= image_tag card[:photo], alt: "" %></figure>
      <% elsif card[:screen] %>
        <figure class="shot"><%= image_tag card[:screen], alt: "" %></figure>
      <% else %>
        <%= render card[:diagram] %>
      <% end %>
    </div>
  </body>
</html>
