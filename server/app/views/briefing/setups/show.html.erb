<% content_for :title, t("briefing.setup.title") %>
<% content_for :rail, render("briefing/rail", variant: "rail", current: "setup") %>
<%= tag.div class: "unit unit--setup", data: {
      controller: "setup",
      setup_devices_value: "#{briefing_root_path}/devices",
      setup_setup_value: briefing_setup_path,
      setup_partner_value: @partner,
      setup_installed_value: @handoff&.product,
      setup_tag_value: @handoff&.tag,
      setup_handoff_value: briefing_setup_handoff_path,
      setup_challenges_value: activation_challenges_path,
      setup_registrations_value: activation_registrations_path,
      setup_glass_outlet: ".glass-prompt"
    } do %>
  <header class="unit-head">
    <h1 class="unit-name" data-setup-target="title"><%= t("briefing.setup.title") %></h1>
  </header>

  <ol class="setup-steps" data-setup-target="steps">
    <li data-step="install"><%= t("briefing.setup.steps.install") %></li>
    <li data-step="connect"><%= t("briefing.setup.steps.connect") %></li>
    <li data-step="aircraft"><%= t("briefing.setup.steps.aircraft") %></li>
  </ol>

  <section class="setup-step" data-setup-target="panel" data-panel="start">
    <p class="unit-lede"><%= t("briefing.setup.start") %></p>
    <p class="setup-ahead" data-setup-target="phoneAhead" hidden><%= t("briefing.setup.phone_ahead") %></p>
    <section class="setup-linux" data-setup-target="linux" aria-labelledby="setup-linux-title" hidden>
      <h2 id="setup-linux-title"><%= t("briefing.setup.linux.title") %></h2>
      <ol class="setup-linux-steps">
        <li data-setup-target="bluetoothFirst" hidden><p><%= t("briefing.setup.linux.bluetooth_first") %></p></li>
        <li>
          <p><%= t("briefing.setup.linux.dialout") %></p>
          <%= render "briefing/copy_code", code: "sudo usermod -aG dialout $USER" %>
          <p class="note"><%= t("briefing.setup.linux.dialout_note") %></p>
        </li>
        <li>
          <p><%= t("briefing.setup.linux.snap") %></p>
          <%= render "briefing/copy_code", code: "sudo snap connect chromium:removable-media" %>
        </li>
      </ol>
    </section>
    <div class="app-actions">
      <button type="button" class="button-app" data-setup-target="install" data-action="setup#restart"><%= t("briefing.setup.install") %></button>
    </div>
  </section>

  <section class="setup-step" data-setup-target="panel" data-panel="drive" hidden>
    <p class="unit-lede" data-setup-target="driveText"></p>
    <ul class="setup-by-hand" data-setup-target="byHand" hidden>
      <li data-product="go">
        <p><%= t("briefing.setup.by_hand.go") %></p>
        <%= render "shared/device", device: :go, label: t("briefing.figures.go_reset"), marks: { reset: t("briefing.figures.reset_twice") } %>
      </li>
      <li data-product="bravo">
        <p><%= t("briefing.setup.by_hand.bravo") %></p>
        <%= render "shared/device", device: :bravo, label: t("briefing.figures.bravo_hold"),
              marks: { button: t("briefing.figures.hold"), led: t("devices.led"), usb: t("briefing.figures.plug") }, lamp: %i[white steady], caption: t("briefing.figures.white") %>
      </li>
    </ul>
    <p class="note" data-setup-target="linux" hidden><%= t("briefing.setup.linux.drive") %></p>
    <div class="app-actions">
      <button type="button" class="button-app" data-setup-target="chooseDrive" data-action="setup#install"><%= t("briefing.setup.choose_drive") %></button>
    </div>
  </section>

  <section class="setup-step" data-setup-target="panel" data-panel="writing" hidden>
    <p class="unit-lede" data-setup-target="writingText"></p>
    <progress class="setup-progress" aria-labelledby="setup-writing"></progress>
    <p class="note" id="setup-writing"><%= t("briefing.setup.keep_plugged") %></p>
  </section>

  <section class="setup-step" data-setup-target="panel" data-panel="connect" hidden>
    <p class="unit-lede" data-setup-target="connectText"></p>
    <figure class="setup-handoff" data-setup-target="handoff" hidden>
      <img data-setup-target="handoffCode" alt="<%= t("briefing.setup.handoff.code") %>" width="176" height="176">
      <figcaption>
        <p data-setup-target="handoffText"></p>
        <p class="note"><%= t("briefing.setup.handoff.type") %></p>
      </figcaption>
    </figure>
    <div class="app-actions">
      <button type="button" class="button-app" data-setup-target="connect" data-action="setup#connectInstalled"><%= t("briefing.setup.connect") %></button>
      <button type="button" class="button-app button-app--quiet" data-setup-target="another" data-action="setup#another" hidden><%= t("briefing.setup.another") %></button>
    </div>
    <p class="note" data-setup-target="connectHint"></p>
  </section>

  <section class="setup-step" data-setup-target="panel" data-panel="phone" hidden>
    <p class="unit-lede"><%= t("briefing.setup.phone.installed") %></p>
    <div class="app-actions">
      <button type="button" class="button-app" data-setup-target="connectPhone" data-action="setup#connectRunning"><%= t("briefing.setup.phone.connect") %></button>
    </div>
    <p class="note"><%= t("briefing.setup.phone.list") %></p>
    <section class="setup-ahead" aria-labelledby="setup-phone-new">
      <h2 id="setup-phone-new"><%= t("briefing.setup.phone.new_title") %></h2>
      <p><%= t("briefing.setup.phone.new") %></p>
      <p class="note"><%= link_to_page "install", label: t("briefing.setup.by_hand_link"), anchor: "si-quelque-chose-bloque" %></p>
    </section>
  </section>

  <section class="setup-step" data-setup-target="panel" data-panel="finish" hidden>
    <p class="unit-lede" data-setup-target="finishText"></p>
    <div data-setup-target="pressBravo" hidden>
      <%= render "shared/device", device: :bravo, label: t("briefing.figures.bravo_press"), marks: { button: t("devices.press"), led: t("devices.led") }, lamp: %i[blue], caption: t("briefing.figures.blue") %>
    </div>
    <div class="app-actions">
      <button type="button" class="button-app" data-setup-target="retry" data-action="setup#retry" hidden><%= t("briefing.setup.try_again") %></button>
    </div>
  </section>

  <section class="setup-step" data-setup-target="panel" data-panel="aircraft" hidden>
    <p class="unit-lede" data-setup-target="aircraftText"></p>
    <form class="setup-aircraft" data-setup-target="aircraftForm" data-action="submit->setup#saveAircraft input->setup#edited change->setup#edited">
      <fieldset class="setup-fields" data-setup-target="aircraftFields">
        <legend class="visually-hidden"><%= t("briefing.settings.aircraft") %></legend>
        <div class="field" data-setting="aircraft_type">
          <label for="setup-aircraft-type"><%= t("settings.aircraft_type") %></label>
          <select id="setup-aircraft-type" name="aircraft_type">
            <% Ownship::AircraftType.all.each do |type| %>
              <option value="<%= type.code %>"><%= type.name %></option>
            <% end %>
          </select>
        </div>
        <div class="field" data-setting="callsign">
          <label for="setup-callsign"><%= t("settings.callsign") %></label>
          <input type="text" id="setup-callsign" name="callsign" maxlength="9" pattern="[A-Za-z0-9 \-]*"
                 autocapitalize="characters" autocomplete="off" spellcheck="false" placeholder="F-JXYZ">
        </div>
        <details class="setup-transponder" data-setting="aircraft_address" data-setup-target="transponder">
          <summary data-setup-target="transponderSummary"></summary>
          <div class="field">
            <label for="setup-aircraft-address"><%= t("settings.aircraft_address") %></label>
            <input type="text" id="setup-aircraft-address" name="aircraft_address" maxlength="6" pattern="[0-9A-Fa-f]{6}"
                   autocapitalize="characters" autocomplete="off" spellcheck="false" placeholder="3C6586">
          </div>
        </details>
      </fieldset>
      <div class="app-actions">
        <button type="submit" class="button-app" data-setup-target="save"><%= t("briefing.setup.save") %></button>
        <button type="button" class="button-app button-app--quiet" data-setup-target="editNow" data-action="setup#editNow" hidden><%= t("briefing.setup.set_now") %></button>
        <button type="button" class="button-app button-app--quiet" data-setup-target="later" data-action="setup#skipAircraft"><%= t("briefing.setup.later") %></button>
      </div>
    </form>
  </section>

  <section class="setup-step" data-setup-target="panel" data-panel="done" hidden>
    <p class="unit-lede" data-setup-target="doneText"></p>
    <div class="app-actions">
      <a class="button-app" data-setup-target="open"></a>
      <a class="button-app button-app--quiet" data-setup-target="setUpPartner" hidden></a>
    </div>
    <ul class="setup-guides" data-setup-target="guides">
      <li data-product="go"><%= link_to_page "go-first-steps", label: t("briefing.setup.guide_go") %></li>
      <li data-product="bravo"><%= link_to_page "bravo-first-steps", label: t("briefing.setup.guide_bravo") %></li>
    </ul>
  </section>

  <section class="setup-step" data-setup-target="panel" data-panel="unsupported" hidden>
    <p class="unit-lede" data-setup-target="unsupportedText"></p>
    <div class="app-actions" data-setup-target="copyLink" hidden>
      <button type="button" class="button-app button-app--quiet" data-controller="copy-to-clipboard" data-action="copy-to-clipboard#copy"
              data-copy-to-clipboard-content-value="<%= request.url %>" data-copy-to-clipboard-success-class="is-copied">
        <span class="when-idle"><%= t("briefing.devices.copy_link") %></span><span class="when-copied"><%= t("briefing.devices.copied") %></span>
      </button>
    </div>
    <p class="note" data-setup-target="byHandLink"><%= link_to_page "install", label: t("briefing.setup.by_hand_link"), anchor: "si-quelque-chose-bloque" %></p>
  </section>

  <div class="unit-message" role="status" data-setup-target="message" hidden>
    <p data-setup-target="messageText"></p>
    <button type="button" class="button-app button-app--small button-app--quiet" data-setup-target="connectRunning" data-action="setup#connectRunning" hidden><%= t("briefing.setup.connect_running") %></button>
  </div>

  <%= render "briefing/glass" %>

  <%= turbo_frame_tag :installers, src: briefing_installer_path, loading: :eager, data: { setup_target: "installers" } %>
<% end %>
