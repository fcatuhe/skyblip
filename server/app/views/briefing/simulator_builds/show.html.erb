<% content_for :stylesheets, area_stylesheet_link_tags("simulator", *("workbench" if @workbench)) %>
<%= turbo_frame_tag :simulator_build do %>
  <% if @unavailable %>
    <p class="<%= class_names("note", "frame-note": @workbench) %>" role="status"><%= t("simulator_builds.unavailable") %></p>
  <% elsif @tag %>
    <% if @release %>
      <p class="note"><%= link_to @release.name, @release.url %></p>
    <% end %>
    <% if @workbench %>
      <%= render "shared/simulator_dev", module_path: simulator_module_path(@tag),
            scenario_manifest_url: release_asset_path(@tag, Release::SIMULATOR_SCENARIOS) %>
    <% else %>
      <%= render "shared/simulator", **t("simulator_builds.controls").symbolize_keys, module_path: simulator_module_path(@tag) %>
    <% end %>
  <% else %>
    <p class="<%= class_names("note", "frame-note": @workbench) %>" role="status"><%= t("simulator_builds.empty") %></p>
  <% end %>
<% end %>
