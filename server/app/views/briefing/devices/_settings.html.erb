<form class="unit-settings" data-unit-target="settings" data-action="input->unit#edit change->unit#edit submit->unit#save" hidden>
  <fieldset class="unit-fields" data-unit-target="fields">
    <legend class="visually-hidden"><%= t("briefing.unit.settings") %></legend>

    <section class="unit-section" aria-labelledby="unit-aircraft-title">
      <h2 class="unit-label" id="unit-aircraft-title"><%= t("briefing.settings.aircraft") %></h2>

      <div class="unit-heard" data-unit-target="heard" hidden>
        <p class="unit-heard-title" role="status" data-unit-target="heardText"></p>
        <table class="unit-heard-changes" data-unit-target="heardChanges">
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden"><%= t("briefing.settings.heard_setting") %></span></th>
              <th scope="col"><%= t("briefing.settings.heard_now") %></th>
              <th scope="col"><%= t("briefing.settings.heard_from") %></th>
            </tr>
          </thead>
          <tbody data-unit-target="heardRows"></tbody>
        </table>
        <button type="button" class="button-app button-app--small" data-unit-target="heardUse" data-action="unit#useHeard"></button>
      </div>

      <div class="field">
        <label for="unit-aircraft-type"><%= t("settings.aircraft_type") %></label>
        <select id="unit-aircraft-type" name="aircraft_type">
          <% Ownship::AircraftType.all.each do |type| %>
            <option value="<%= type.code %>"><%= type.name %></option>
          <% end %>
        </select>
      </div>

      <div class="field">
        <label for="unit-callsign"><%= t("settings.callsign") %></label>
        <input type="text" id="unit-callsign" name="callsign" maxlength="9" pattern="[A-Za-z0-9 \-]*"
               autocapitalize="characters" autocomplete="off" spellcheck="false">
      </div>

      <div class="field" hidden>
        <label for="unit-aircraft-address"><%= t("settings.aircraft_address") %></label>
        <input type="text" id="unit-aircraft-address" name="aircraft_address" maxlength="6" pattern="[0-9A-Fa-f]{6}"
               autocapitalize="characters" autocomplete="off" spellcheck="false" aria-describedby="unit-aircraft-address-hint">
        <p class="field-hint" id="unit-aircraft-address-hint"><%= aircraft_address_hint(slug) %></p>
      </div>
    </section>

    <section class="unit-section" aria-labelledby="unit-device-title">
      <h2 class="unit-label" id="unit-device-title"><%= t("briefing.settings.device") %></h2>

      <div class="field">
        <label for="unit-alarm"><%= t("briefing.settings.alarm") %></label>
        <select id="unit-alarm" name="alarm">
          <% t("briefing.settings.alarm_names").each do |value, name| %>
            <% if %i[soft loud].include?(value) %>
              <option value="<%= value %>" data-sounds data-label="<%= name %>" data-on-bravo="<%= t("briefing.settings.bravo_alarm_names.#{value}") %>"><%= name %></option>
            <% else %>
              <option value="<%= value %>"><%= name %></option>
            <% end %>
          <% end %>
        </select>
        <p class="field-hint" id="unit-alarm-set-on-go" data-unit-target="setOnGo" hidden><%= t("briefing.settings.set_on_go") %></p>
        <p class="field-default" data-unit-target="default" data-setting="alarm" hidden></p>
      </div>

      <div class="field">
        <label for="unit-units"><%= t("briefing.settings.units") %></label>
        <select id="unit-units" name="units">
          <% t("briefing.settings.unit_names").each do |value, name| %>
            <option value="<%= value %>"><%= name %></option>
          <% end %>
        </select>
        <p class="field-default" data-unit-target="default" data-setting="units" hidden></p>
      </div>
    </section>
  </fieldset>

  <p class="unit-message" role="status" data-unit-target="settingsMessage" hidden></p>
  <div class="app-actions">
    <button type="button" class="button-app" data-unit-target="reconnect" data-action="unit#reconnect" hidden><%= t("briefing.unit.reconnect") %></button>
    <button type="submit" class="button-app" data-unit-target="save" data-label="<%= t("briefing.settings.save") %>" disabled><%= t("briefing.settings.save") %></button>
    <button type="button" class="button-app button-app--text" data-unit-target="reset" data-action="unit#reset" hidden><%= t("briefing.settings.reset") %></button>
  </div>
</form>
