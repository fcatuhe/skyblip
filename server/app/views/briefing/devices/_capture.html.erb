<form class="unit-capture" data-unit-target="capture" data-action="submit->unit#armCapture" aria-labelledby="unit-capture-title" hidden>
  <h2 class="unit-label" id="unit-capture-title"><%= t("briefing.capture.title") %></h2>
  <fieldset class="unit-fields" data-unit-target="captureFields">
    <div class="field">
      <label for="unit-capture-profile"><%= t("briefing.capture.profile") %></label>
      <select id="unit-capture-profile" name="profile" data-unit-target="captureProfile" aria-describedby="unit-capture-hint">
        <% t("briefing.capture.profile_names").each do |value, name| %>
          <option value="<%= value %>"><%= name %></option>
        <% end %>
      </select>
      <p class="field-hint" id="unit-capture-hint"><%= t("briefing.capture.hint") %></p>
    </div>
  </fieldset>

  <p class="unit-message" role="status" data-unit-target="captureMessage" hidden></p>
  <div class="unit-capture-actions">
    <button type="submit" class="button-app" data-unit-target="captureArm" data-label="<%= t("briefing.capture.arm") %>" disabled><%= t("briefing.capture.arm") %></button>
    <button type="button" class="button-app button-app--text" data-unit-target="captureStop" data-action="unit#stopCapture" disabled><%= t("briefing.capture.stop") %></button>
  </div>
</form>
