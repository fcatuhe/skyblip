<%= tag.nav class: "locale-switcher", aria: { label: "Language" }, data: {
      controller: ("locale" unless crawler?),
      locale_current_value: I18n.locale,
      locale_default_value: I18n.default_locale,
      locale_available_value: I18n.available_locales.to_json,
      locale_alternates_value: page_alternate_paths.to_json
    } do %>
  <% I18n.available_locales.each do |locale| %>
    <% if locale == I18n.locale %>
      <span aria-current="true"><%= locale.to_s.upcase %></span>
    <% elsif (path = page_alternate_paths[locale]) %>
      <%= link_to locale.to_s.upcase, path,
            data: { action: "locale#choose", locale_locale_param: locale } %>
    <% else %>
      <span aria-disabled="true"><%= locale.to_s.upcase %></span>
    <% end %>
  <% end %>
<% end %>
