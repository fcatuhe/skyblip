<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= site_name %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= tag.meta name: "description", content: description if description %>
    <%= tag.meta name: "author", content: author %>
    <%= share_meta_tags %>

    <%= tag :link, rel: "canonical", href: canonical_url %>

    <%= hreflang_link_tags %>

    <%= tag :meta, name: "robots", content: robots_content %>

    <%= structured_data_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json, locale: nil) %>
    <%= tag.meta name: "theme-color", content: theme_color %>

    <link rel="icon" href="/icon.png" type="image/png" sizes="512x512">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= preload_link_tag "Inter-Regular.woff2" %>
    <%= preload_link_tag "FiraSans-Bold.woff2" %>

    <%= site_stylesheet_link_tags %>
    <%= yield :stylesheets %>
    <%= javascript_importmap_tags %>
    <%= javascript_import_module_tag "ahoy-module" unless Ahoy.api_only %>
  </head>

  <body>
    <%= render "layouts/nav" %>

    <main>
      <%= content_for?(:content) ? yield(:content) : yield %>
    </main>

    <%= render "layouts/footer" %>
  </body>
</html>
