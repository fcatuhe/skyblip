<% content_for :stylesheets, area_stylesheet_link_tags("admin") %>
<% content_for :noindex, "noindex" %>
<% content_for :content do %>
  <div class="admin">
    <nav class="admin-nav" aria-label="Admin">
      <ul>
        <li><%= link_to "Analytics", analytics_default_path, "aria-current": ("page" if controller_path.start_with?("admin/analytics")) %></li>
        <li><%= link_to "Insights", admin_insights_path, "aria-current": ("page" if controller_path == "admin/insights") %></li>
        <li><%= link_to "Errors", admin_errors_path, "aria-current": ("page" if controller_path == "admin/errors") %></li>
        <li><%= link_to "Events", admin_events_path, "aria-current": ("page" if controller_path == "admin/events") %></li>
        <li><%= link_to "Users", admin_users_path, "aria-current": ("page" if controller_path == "admin/users") %></li>
        <li><%= link_to "Units", admin_units_path, "aria-current": ("page" if controller_path == "admin/units") %></li>
        <li><%= link_to "Jobs", admin_mission_control_jobs_path, target: "mission_control" %></li>
      </ul>
      <%= button_to "Sign out", session_path, method: :delete, class: "button button--secondary button--small" %>
    </nav>

    <% flash.each do |type, message| %>
      <p class="admin-flash admin-flash--<%= type %>" role="status"><%= message %></p>
    <% end %>

    <%= yield %>
  </div>
<% end %>
<%= render template: "layouts/application" %>
