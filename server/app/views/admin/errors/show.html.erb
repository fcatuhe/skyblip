<% content_for :title, "#{@error.error} · Errors" %>
<header class="admin-header">
  <h1><%= @error.error %></h1>
</header>

<dl class="admin-details">
  <dt>Message</dt>
  <dd><%= @error.message %></dd>
  <dt>Side</dt>
  <dd><%= @error.side %></dd>
  <dt>Times</dt>
  <dd><%= @error.count %>, on <%= pluralize(@error.devices, "device") %> and <%= pluralize(@error.browsers, "browser") %></dd>
  <dt>First seen</dt>
  <dd><%= event_time(@error.first_at) %></dd>
  <dt>Last seen</dt>
  <dd><%= event_time(@error.last_at) %><%= ", revision #{@error.latest.payload["revision"]}" if @error.latest.payload["revision"] %></dd>
  <dt>Fingerprint</dt>
  <dd class="mono"><%= @error.fingerprint %></dd>
  <% if @error.resolution %>
    <dt><%= @error.reopened? ? "Reopened" : "Resolved" %></dt>
    <dd>
      <% if @error.reopened? %>
        Seen again after it was resolved <%= event_time(@error.resolution.resolved_at) %>
      <% else %>
        <%= event_time(@error.resolution.resolved_at) %>
      <% end %>
    </dd>
  <% end %>
</dl>

<div class="admin-actions">
  <% if @error.resolved? %>
    <%= button_to "Reopen", admin_error_resolution_path(@error.fingerprint), method: :delete, class: "button button--small" %>
  <% else %>
    <%= button_to "Resolve", admin_error_resolution_path(@error.fingerprint), class: "button button--primary button--small" %>
  <% end %>
</div>

<% if (frames = @error.latest.payload["frames"]).present? %>
  <h2>Where</h2>
  <pre class="admin-frames"><%= frames.join("\n") %></pre>
<% end %>

<h2>Latest occurrences</h2>
<%= render "admin/events/list", events: @error.occurrences %>

<p><%= link_to "All errors", admin_errors_path %></p>
