<% content_for :title, "Errors" %>
<header class="admin-header">
  <h1>Errors</h1>
  <nav class="admin-tabs" aria-label="Period">
    <% Event::Review::PERIODS.each do |days| %>
      <%= link_to "#{days} days", admin_errors_path(days:), "aria-current": ("page" if days == @days) %>
    <% end %>
  </nav>
</header>

<% if @errors.empty? %>
  <p>Nothing broke in the last <%= @days %> days<%= " that is not resolved" if @resolved.any? %>.</p>
<% else %>
  <%= render "admin/errors/table", errors: @errors, since: @since %>
<% end %>

<% if @resolved.any? %>
  <h2>Resolved</h2>
  <%= render "admin/errors/table", errors: @resolved, since: @since %>
<% end %>
