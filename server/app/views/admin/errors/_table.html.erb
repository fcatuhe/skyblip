<div class="table-scroll">
  <table>
    <thead>
      <tr>
        <th>Error</th>
        <th>Side</th>
        <th>Times</th>
        <th>Devices</th>
        <th>Browsers</th>
        <th>First seen</th>
        <th>Last seen</th>
      </tr>
    </thead>
    <tbody>
      <% errors.each do |error| %>
        <tr>
          <th>
            <%= link_to error.error, admin_error_path(error.fingerprint) %>
            <% if error.new_since?(since) %><span class="admin-badge">new</span><% end %>
            <% if error.reopened? %><span class="admin-badge">reopened</span><% end %>
            <div class="quiet"><%= error.message.to_s.truncate(120) %></div>
            <div class="mono quiet"><%= error.place %></div>
          </th>
          <td><%= error.side %></td>
          <td><%= error.count %></td>
          <td><%= error.devices %></td>
          <td><%= error.browsers %></td>
          <td><%= event_time(error.first_at) %></td>
          <td><%= event_time(error.last_at) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
