<header class="admin-header">
  <h1><%= @user.name %></h1>
  <%= link_to "Edit", edit_admin_user_path(@user), class: "button button--primary button--small" %>
  <% if Current.user.can_administer?(@user) %>
    <%= button_to "Delete", admin_user_path(@user), method: :delete, class: "button button--danger button--small",
          form: { data: { turbo_confirm: "Delete #{@user.name}?" } } %>
  <% end %>
</header>

<dl class="admin-details">
  <dt>Email</dt>
  <dd><%= @user.email %></dd>
  <dt>Role</dt>
  <dd><%= @user.role %></dd>
  <dt>Created</dt>
  <dd><%= l @user.created_at, format: "%b %-d, %Y, %H:%M" %></dd>
</dl>

<p><%= link_to "All users", admin_users_path %></p>
