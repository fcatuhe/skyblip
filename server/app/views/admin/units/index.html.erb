<header class="admin-header">
  <h1>Units</h1>
</header>

<% if Unit.daily_cap_reached? %>
  <p class="admin-flash admin-flash--alert" role="alert">
    The daily cap of <%= Unit::NEW_PER_DAY %> new units is reached: new units are refused until midnight UTC.
  </p>
<% end %>

<% if @server_key %>
  <dl class="admin-details">
    <dt>Server key</dt>
    <dd><span class="mono"><%= @server_key.id %></span>, public key <span class="mono"><%= @server_key.public_key %></span></dd>
  </dl>
<% else %>
  <p class="admin-flash admin-flash--alert" role="alert">
    No server key in the credentials: every activation fails. The README's Activation section says how to add it.
  </p>
<% end %>

<div class="table-scroll">
  <table>
    <thead>
      <tr>
        <th>Address</th>
        <th>Serial</th>
        <th>Device ID</th>
        <th>Key</th>
        <th>Pending</th>
        <th>Firmware</th>
        <th>Build</th>
        <th>Activated</th>
      </tr>
    </thead>
    <tbody>
      <% @units.each do |unit| %>
        <tr>
          <th><%= link_to unit.address, admin_unit_path(unit), class: "mono" %></th>
          <td><%= unit.serial %></td>
          <td class="mono"><%= unit.device_id %></td>
          <td class="mono"><%= unit.active_key&.public_key&.first(8) || "none" %></td>
          <td><%= unit.keys.count(&:pending?) %></td>
          <td class="mono"><%= unit.active_key&.version %></td>
          <td><%= unit_key_build(unit.active_key) %></td>
          <td><%= l unit.created_at, format: "%b %-d, %Y" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
