<div class="manage-field">
  <label for="<%= scope %>-aircraft-type"><%= t("settings.aircraft_type") %></label>
  <select id="<%= scope %>-aircraft-type" name="aircraft_type">
    <% Ownship::AircraftType.all.each do |type| %>
      <option value="<%= type.code %>"><%= type.name %></option>
    <% end %>
  </select>
  <% if defaults %>
    <p class="manage-default" data-<%= scope %>-target="default" data-setting="aircraft_type" hidden></p>
  <% end %>
</div>

<div class="manage-field">
  <label for="<%= scope %>-callsign"><%= t("settings.callsign") %></label>
  <input type="text" id="<%= scope %>-callsign" name="callsign" maxlength="9" pattern="[A-Za-z0-9 \-]*"
         autocapitalize="characters" autocomplete="off" spellcheck="false" aria-describedby="<%= scope %>-callsign-hint">
  <p class="manage-hint" id="<%= scope %>-callsign-hint"><%= t("settings.callsign_hint") %></p>
  <% if defaults %>
    <p class="manage-default" data-<%= scope %>-target="default" data-setting="callsign" hidden></p>
  <% end %>
</div>

<div class="manage-field" hidden>
  <label for="<%= scope %>-own-icao"><%= t("settings.own_icao") %></label>
  <input type="text" id="<%= scope %>-own-icao" name="own_icao" maxlength="6" pattern="[0-9A-Fa-f]{6}"
         autocapitalize="characters" autocomplete="off" spellcheck="false" aria-describedby="<%= scope %>-own-icao-hint">
  <p class="manage-hint" id="<%= scope %>-own-icao-hint"><%= t("settings.own_icao_hint") %></p>
  <% if defaults %>
    <p class="manage-default" data-<%= scope %>-target="default" data-setting="own_icao" hidden></p>
  <% end %>
</div>
