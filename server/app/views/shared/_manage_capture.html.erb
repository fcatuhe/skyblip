<form class="manage-settings" data-manage-target="capture" data-action="submit->manage#armCapture" hidden>
  <fieldset data-manage-target="captureFields">
    <legend><%= capture[:legend] %></legend>
    <p class="note"><%= capture[:lede] %></p>

    <div class="manage-field">
      <label for="manage-capture-profile"><%= capture[:profile] %></label>
      <select id="manage-capture-profile" name="profile" data-manage-target="captureProfile">
        <% capture[:profile_names].each do |value, name| %>
          <option value="<%= value %>"><%= name %></option>
        <% end %>
      </select>
    </div>
  </fieldset>

  <div class="manage-row">
    <button type="submit" class="manage-button" data-manage-target="captureArm" disabled><%= capture[:arm] %></button>
    <button type="button" class="manage-button manage-button--quiet" data-manage-target="captureStop" data-action="manage#stopCapture" disabled><%= capture[:stop] %></button>
  </div>
  <p class="note"><%= capture[:confirm] %></p>
  <p class="manage-message" role="status" data-manage-target="captureMessage"></p>
</form>
