<%= turbo_frame_tag :firmware_shelf, src: briefing_firmwares_path, loading: :eager do %>
  <p class="note" role="status"><%= t("firmwares.loading") %></p>
<% end %>

<div class="manage-row">
  <label class="manage-file">
    <span><%= file %></span>
    <input type="file" accept=".bin" data-manage-target="file" data-action="manage#choose">
  </label>
  <button type="button" class="manage-button" data-manage-target="install" data-action="manage#install" disabled><%= install %></button>
</div>

<ol class="manage-steps">
  <% steps.each do |step, words| %>
    <li data-manage-target="step" data-step="<%= step %>" data-manage-word="step_<%= step %>"><%= words %></li>
  <% end %>
</ol>

<progress class="manage-progress" data-manage-target="progress" max="1" value="0" hidden></progress>
<p class="manage-progress-text" data-manage-target="progressText" hidden></p>

<p class="manage-message" role="status" data-manage-target="message"></p>

<details class="manage-recovery">
  <summary><%= recovery %></summary>
  <p data-manage-word="confirm_recovery"><%= confirm_recovery %></p>
  <p data-manage-word="recovering"><%= recovering %></p>
  <button type="button" class="manage-button manage-button--quiet" data-manage-target="recover" data-action="manage#recover" disabled><%= recover %></button>
</details>
