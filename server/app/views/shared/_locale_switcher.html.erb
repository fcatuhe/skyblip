<%# locals: (alternates: page_alternate_paths) -%>
<%= tag.nav class: "locale-switcher", aria: { label: "Language" }, data: {
      controller: ("locale" unless crawler?),
      locale_current_value: I18n.locale,
      locale_default_value: I18n.default_locale,
      locale_available_value: I18n.available_locales.to_json,
      locale_alternates_value: alternates.to_json
    } do %>
  <details>
    <summary><%= locale_flag(I18n.locale) %><%= I18n.locale.to_s.upcase %></summary>
    <ul>
      <% switcher_locales.each do |locale| %>
        <% label = safe_join([ locale_flag(locale), t("language_name", locale:) ]) %>
        <li lang="<%= locale %>">
          <% if locale == I18n.locale %>
            <span aria-current="true"><%= label %></span>
          <% elsif (path = alternates[locale]) %>
            <%= link_to label, path, hreflang: locale, data: { action: "locale#choose", locale_locale_param: locale } %>
          <% else %>
            <span aria-disabled="true"><%= label %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </details>
<% end %>
