<% compact = local_assigns.fetch(:compact, false) %>
<% km = compact ? 14 : 24 %>
<% metre = compact ? 0.08 : 0.13 %>
<% plan = compact ? [ 60, 76 ] : [ 104, 118 ] %>
<% side = compact ? [ 190, 76 ] : [ 316, 118 ] %>
<% ground_m = -200 %>
<% traffic = [
     { key: :advisory, east: 0.9, north: 1.1, up: 180, css: "diagram-traffic" },
     { key: :far, east: -3.8, north: -0.6, up: 60, css: "diagram-traffic diagram-traffic--quiet" },
     { key: :high, east: -1.3, north: 1.2, up: 480, css: "diagram-traffic diagram-traffic--quiet" },
     { key: :on_ground, east: 2.1, north: -1.3, up: ground_m, css: "diagram-traffic diagram-traffic--quiet" }
   ] %>
<% at = ->(origin, dx, dy) { [ (origin[0] + dx).round(1), (origin[1] - dy).round(1) ] } %>
<% diamond = ->(cx, cy, css) { tag.path(class: css, d: "M#{cx},#{cy - 6} L#{cx + 5},#{cy} L#{cx},#{cy + 6} L#{cx - 5},#{cy} z") } %>
<% own = ->(cx, cy) { tag.path(class: "diagram-own", d: "M#{cx},#{cy - 7} L#{cx + 5},#{cy + 6} L#{cx},#{cy + 3} L#{cx - 5},#{cy + 6} z") } %>
<% ground_y = side[1] - ground_m * metre %>
<figure class="diagram <%= compact ? "diagram--compact" : "diagram--wide" %>">
  <svg viewBox="0 0 <%= compact ? "280 140" : "420 200" %>" role="img" aria-labelledby="advisory-ring-title advisory-ring-description">
    <title id="advisory-ring-title"><%= t "advisory_ring.title" %></title>
    <desc id="advisory-ring-description"><%= t "advisory_ring.description" %></desc>

    <text class="diagram-label" x="<%= plan[0] %>" y="14"><%= t "advisory_ring.above" %></text>
    <text class="diagram-label" x="<%= side[0] %>" y="14"><%= t "advisory_ring.side" %></text>

    <%= tag.circle class: "diagram-ring", cx: plan[0], cy: plan[1], r: 3 * km %>
    <% radius = compact ? -3 * km : 3 * km %>
    <line class="diagram-dimension" x1="<%= plan[0] %>" y1="<%= plan[1] %>" x2="<%= plan[0] + radius %>" y2="<%= plan[1] %>"/>
    <text class="diagram-note" x="<%= plan[0] + radius / 2 %>" y="<%= plan[1] + 14 %>">3 km</text>

    <%= tag.rect class: "diagram-ground", x: side[0] - 3.9 * km, y: ground_y, width: 7.8 * km, height: (compact ? 10 : 16) %>
    <%= tag.rect class: "diagram-ring", x: side[0] - 3 * km, y: (side[1] - 300 * metre).round(1), width: 6 * km, height: (600 * metre).round(1) %>
    <line class="diagram-ground-line" x1="<%= side[0] - 3.9 * km %>" y1="<%= ground_y %>" x2="<%= side[0] + 3.9 * km %>" y2="<%= ground_y %>"/>
    <% if compact %>
      <text class="diagram-note diagram-note--start" x="<%= side[0] + 3 * km + 4 %>" y="<%= (side[1] - 300 * metre + 9).round(1) %>">300 m</text>
    <% else %>
      <line class="diagram-dimension" x1="<%= side[0] %>" y1="<%= side[1] %>" x2="<%= side[0] + 3 * km %>" y2="<%= side[1] %>"/>
      <text class="diagram-note" x="<%= side[0] + 1.5 * km %>" y="<%= side[1] - 5 %>">3 km</text>
      <line class="diagram-dimension" x1="<%= side[0] %>" y1="<%= side[1] %>" x2="<%= side[0] %>" y2="<%= (side[1] - 300 * metre).round(1) %>"/>
      <text class="diagram-note diagram-note--end" x="<%= side[0] - 5 %>" y="<%= (side[1] - 150 * metre + 4).round(1) %>">300 m</text>
    <% end %>

    <%= own.(*plan) %>
    <%= own.(*side) %>
    <% traffic.each do |aircraft| %>
      <%= diamond.(*at.(plan, aircraft[:east] * km, aircraft[:north] * km), aircraft[:css]) %>
      <% sx, sy = at.(side, aircraft[:east] * km, aircraft[:up] * metre) %>
      <%= diamond.(sx, aircraft[:up] == ground_m ? sy - 6 : sy, aircraft[:css]) %>
    <% end %>

    <% unless compact %>
      <% labels = { advisory: [ :start, 9, -4 ], far: [ :end, 6, -10 ], high: [ :start, 9, 4 ], on_ground: [ :middle, 0, 32 ] } %>
      <% traffic.each do |aircraft| %>
        <% anchor, dx, dy = labels[aircraft[:key]] %>
        <% sx, sy = at.(side, aircraft[:east] * km, aircraft[:up] * metre) %>
        <text class="diagram-note <%= "diagram-note--#{anchor}" unless anchor == :middle %> <%= "diagram-note--transmit" if aircraft[:key] == :advisory %>" x="<%= sx + dx %>" y="<%= sy + dy %>"><%= t "advisory_ring.#{aircraft[:key]}" %></text>
      <% end %>
    <% end %>
  </svg>
</figure>
