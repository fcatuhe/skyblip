  <h2 class="section-title">skyBlip Go</h2>
  <div class="faq">
    <div class="table-scroll">
      <table class="modules">
        <thead><tr><th>Pièce</th><th>Où la trouver</th><th>Prix</th></tr></thead>
        <tbody>
          <tr><th>Disque</th><td><a href="https://fr.aliexpress.com/item/1005008735044863.html">Disque plat 1/4&Prime;</a>, variante Type A, Ver.2, dos adhésif</td><td>5,89&nbsp;€</td></tr>
          <tr><th>Vis</th><td><a href="https://fr.aliexpress.com/item/1005002281189492.html">Vis M3 à tête extra-plate</a>, M3&nbsp;x&nbsp;6 et M3&nbsp;x&nbsp;8</td><td>&mdash;</td></tr>
          <tr><th>Attache rapide, mâle</th><td>Plaque QS-1, dans le <a href="https://s.click.aliexpress.com/e/_c4rEgYRR" target="_blank" rel="sponsored">kit d&rsquo;attache rapide XILETU</a>, variante Q-1</td><td>3,39&nbsp;€</td></tr>
