        <tr><th scope="row">Aereo pesante</th><td><code>HEAVY</code></td></tr>
        <tr><th scope="row">Elicottero leggero</th><td><code>LIGHT HELI</code></td></tr>
        <tr><th scope="row">Elicottero pesante</th><td><code>HEAVY HELI</code></td></tr>
        <tr><th scope="row">Aliante</th><td><code>GLIDER</code></td></tr>
        <tr><th scope="row">Mongolfiera</th><td><code>BALLOON</code></td></tr>
        <tr><th scope="row">Ultraleggero</th><td><code>MICROLIGHT</code></td></tr>
        <tr><th scope="row">Parapendio</th><td><code>PARAGLIDER</code></td></tr>
        <tr><th scope="row">Paracadutista</th><td><code>SKYDIVER</code></td></tr>
        <tr><th scope="row">VTOL</th><td><code>VTOL</code></td></tr>
